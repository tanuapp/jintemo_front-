# Frontend requests use /api through the development proxy or production gateway.
# If your local API runs on a different port, set API_PROXY_TARGET in the terminal.
# No JWT secret or MongoDB URI belongs in the frontend.

# Optional server-side override for a separately deployed backend.
# Set this in Vercel Environment Variables for Production and Preview.
# Without it, the production gateway uses the JINTEMO backend below.
# API_PROXY_TARGET=https://jintemo-backend-new.vercel.app
